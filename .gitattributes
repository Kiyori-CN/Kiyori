* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.aar binary
*.aab binary
*.apk binary
*.gif binary
*.ico binary
*.jar binary
*.jpeg binary
*.jpg binary
*.keystore binary
*.png binary
*.so binary
*.webp binary
*.zip binary

# Anime4K assets are hash-locked third-party source files. Preserve their
# upstream whitespace exactly instead of rewriting bytes that MPV consumes.
app/src/main/assets/shaders/*.glsl -text !eol -whitespace
