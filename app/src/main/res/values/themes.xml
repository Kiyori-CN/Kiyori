<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Operit" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kiyori_primary</item>
        <item name="colorPrimaryVariant">@color/kiyori_primary</item>
        <item name="colorOnPrimary">@color/kiyori_on_primary</item>
        <item name="colorSecondary">@color/kiyori_secondary</item>
        <item name="colorSecondaryVariant">@color/kiyori_secondary</item>
        <item name="colorOnSecondary">@color/kiyori_on_secondary</item>
        <item name="colorSurface">@color/kiyori_surface</item>
        <item name="colorOnSurface">@color/kiyori_on_surface</item>
        <item name="android:colorBackground">@color/kiyori_background</item>
        <item name="android:windowBackground">@color/kiyori_background</item>
        <item name="android:statusBarColor">@color/kiyori_background</item>
        <item name="android:navigationBarColor">@color/kiyori_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/kiyori_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_kiyori_splash_transparent</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="s">0</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
