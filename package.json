{
  "name": "kiyori-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Private development tooling for the Kiyori Android project",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "scripts": {
    "build:examples:academic": "tsc -p examples/tsconfig.json --pretty false",
    "build:examples:github": "node ./examples/github/build.js",
    "live:examples:academic": "node ./tools/example_packages/academic_packages.live.mjs",
    "test:examples:academic": "node --test ./tools/example_packages/academic_packages.test.mjs",
    "test:toolpkg:types": "tsc -p tools/compose_dsl/tsconfig.contracts.json --pretty false",
    "build:webchat": "npm --prefix web-chat run build && npm --prefix web-chat run sync:android-assets"
  },
  "devDependencies": {
    "@types/node": "^22.4.1",
    "esbuild": "^0.25.0",
    "typescript": "5.9.3"
  }
}
