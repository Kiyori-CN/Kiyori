{
  "schema_version": 1,
  "toolpkg_id": "com.operit.windows_bundle",
  "version": "1.0.0",
  "main": "dist/main.js",
  "display_name": {
    "zh": "Windows 工具包",
    "en": "Windows Toolkit"
  },
  "description": {
    "zh": "配置 Kiyori PC Agent，并通过局域网在 Windows 上执行 PowerShell 或 CMD 命令并返回输出。",
    "en": "Configure Kiyori PC Agent, then execute PowerShell or CMD commands on Windows over the LAN and return their output."
  },
  "enabled_by_default": false,
  "subpackages": [
    {
      "id": "windows_control",
      "entry": "dist/packages/windows_control.js"
    }
  ],
  "resources": [
    {
      "key": "pc_agent_zip",
      "path": "resources/pc_agent/operit-pc-agent",
      "mime": "inode/directory"
    }
  ]
}
